              "listen": "test",
              "script": {
                "exec": [
                  "const responseJson = pm.response.json();",
                  "if (responseJson.success && responseJson.data && responseJson.data._id) {",
                  "    pm.collectionVariables.set('imageId', responseJson.data._id);",
                  "    console.log('Saved imageId:', responseJson.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "title",
                  "value": "Cyberpunk Neon Skyline",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "technology",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "A beautiful view of city lights at twilight.",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "cyberpunk,night,city,lights",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/images/upload",
              "host": ["{{baseUrl}}"],
              "path": ["images", "upload"]
            }
          },
          "response": []
