            ],
            "url": {
              "raw": "{{baseUrl}}/notes?category=Work",
              "host": ["{{baseUrl}}"],
              "path": ["notes"],
              "query": [
                { "key": "category", "value": "Work" }
              ]
            }
          },
          "response": []
