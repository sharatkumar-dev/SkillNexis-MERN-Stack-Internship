        {
          "name": "Filter Archived Notes Only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notes?isArchived=true",
              "host": ["{{baseUrl}}"],
              "path": ["notes"],
              "query": [
                { "key": "isArchived", "value": "true" }
              ]
            }
          },
          "response": []
        }
      ]
    },
