              "host": ["{{baseUrl}}"],
              "path": ["notes"],
              "query": [
                { "key": "q", "value": "architecture" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Filter Notes by Category",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
